PORTKEY_API_KEY=
# Runtime course model is fixed to gpt-6-luna (not configurable).
# Application loads process env first, then repo .env, then the immediate parent .env for missing values.
# Optional: FURNISHAI_DISABLE_LIVE=1 never calls the AI model (demo/offline use).
# Optional: FURNISHAI_STORAGE_DIR=/path/to/storage (default ./storage).
# Optional: FURNISHAI_PUBLIC_READER=off turns off the public page reader fallback for property sites.
# Optional AI allowances (estimated costs from returned usage, not invoices). Invalid values stop the app at start-up.
#   FURNISHAI_SESSION_AI_BUDGET_USD=2.00   lifetime allowance per browser session (default 2.00; more than 0, at most 20)
#   FURNISHAI_DAILY_AI_BUDGET_USD=3.00     app-wide per UTC day (default 3.00; more than 0, at most 100)
#   FURNISHAI_AI_REQUESTS_PER_10MIN=12     AI requests per session per rolling ten minutes (default 12; 1 to 120)
